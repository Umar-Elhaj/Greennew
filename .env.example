# ============================================================
# GREEN — environment variables (copy to .env for local development;
# on o2switch, set them in cPanel > Setup Python App > Environment variables).
# NEVER commit real values. Only DATABASE_URL and SECRET_KEY are required:
# every other variable only enables an optional feature.
# ============================================================

# ---- Required ----------------------------------------------

# MySQL/MariaDB database of the o2switch account (cPanel > Bases de données
# MySQL). cPanel prefixes the database and user names with the account name:
#   mysql://sc1jsgw2086_green:<password>@localhost:3306/sc1jsgw2086_green
# mysql:// and mariadb:// are both accepted: the PyMySQL driver and
# charset=utf8mb4 are added automatically, each session runs in UTC with a
# strict SQL mode, small pool (2 + 2 overflow) per Passenger process.
# Encode @ : / ? # % in the password (e.g. @ → %40), or avoid them.
# Leave empty for local development: a SQLite file (green.db) is used.
DATABASE_URL=

# JWT signing key, mandatory when DEBUG=false (the app refuses to start).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- Mode --------------------------------------------------

# true only on a developer machine (API docs at /docs, dev SECRET_KEY allowed).
DEBUG=false

# Comma-separated origins allowed to call the API from another domain.
# Leave empty on o2switch: the same domain serves the pages and the API.
CORS_ORIGINS=

# ---- Storage -----------------------------------------------

# Where analysed images are written. On o2switch: OUTSIDE public_html,
# e.g. /home/<account>/green_media. Default: <repo>/data/captures
MEDIA_DIR=

# Maximum size of one uploaded image, in MB (default 8).
MAX_UPLOAD_MB=8

# ---- Inference ---------------------------------------------

# onnx (production, onnxruntime) or torch (development, needs torch + timm).
INFERENCE_BACKEND=onnx
# Model file. Default: Models/best_efficientnet.onnx (onnx) or .pth (torch).
MODEL_PATH=
# Stored with each analysis (dataset traceability).
MODEL_VERSION=efficientnet-v1
# 1 = load the model when each Passenger process starts (≈180 MB each);
# empty = load it on the first analysis (recommended on shared hosting).
WARMUP=

# ---- Optional services -------------------------------------

# GreenBot (Google Gemini). Empty → the chatbot answers 503 with a clear message.
GEMINI_API_KEY=
# Gemini model name (optional; default gemini-3.1-flash-lite).
GEMINI_MODEL=

# Weather widget (OpenWeatherMap). Empty → the widget shows "unavailable".
WEATHER_API_KEY=
